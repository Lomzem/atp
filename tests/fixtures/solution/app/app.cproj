<?xml version="1.0" encoding="utf-8"?>
<!--
  A stand-in for an Atmel Studio project, holding only the properties atp
  reads. It is here so the tests can exercise discovery, parsing and artifact
  paths. Atmel Studio itself cannot build it, and no test asks it to.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>7.0</ProjectVersion>
    <ToolchainName>com.Atmel.ARMGCC.C</ToolchainName>
    <ProjectGuid>{11111111-2222-3333-4444-555555555555}</ProjectGuid>
    <avrdevice>ATSAM4E8C</avrdevice>
    <avrdeviceseries>sam4e</avrdeviceseries>
    <OutputType>Executable</OutputType>
    <Language>C</Language>
    <OutputFileName>$(MSBuildProjectName)</OutputFileName>
    <OutputFileExtension>.elf</OutputFileExtension>
    <OutputDirectory>$(MSBuildProjectDirectory)\$(Configuration)</OutputDirectory>
    <AssemblyName>app</AssemblyName>
    <Name>app</Name>
    <UncachedRange />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <ToolchainSettings>
      <ArmGcc>
        <armgcc.common.outputfiles.hex>True</armgcc.common.outputfiles.hex>
        <armgcc.common.outputfiles.bin>True</armgcc.common.outputfiles.bin>
      </ArmGcc>
    </ToolchainSettings>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <ToolchainSettings>
      <ArmGcc />
    </ToolchainSettings>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release_to_application_partition' ">
    <ToolchainSettings>
      <ArmGcc />
    </ToolchainSettings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\main.c">
      <SubType>compile</SubType>
    </Compile>
  </ItemGroup>
  <Import Project="$(AVRSTUDIO_EXE_PATH)\\Vs\\Compiler.targets" />
</Project>
